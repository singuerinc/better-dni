{
  "name": "better-dni",
  "version": "5.2.0",
  "description": "The fastest Spanish DNI (NIE / NIF) validation out there.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "license": "MIT",
  "author": "Nahuel Scotti <nahuel.scotti@gmail.com> (https://www.singuerinc.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singuerinc/better-dni.git",
    "directory": "packages/better-dni"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "benchmark": "tsx benchmark.ts",
    "build": "vite build",
    "dev": "tsc -w",
    "lint": "eslint src",
    "format": "prettier --write \"./src/**/*.{ts,tsx,html}\"",
    "playground": "tsx playground.ts",
    "size": "size-limit",
    "test": "vitest run",
    "prepublish": "cp ../../README.md ./"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@semantic-release/git": "^11.0.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "@willowi/validate-nif": "^1.0.1",
    "dni-js": "^1.0.0",
    "dni-js-validator": "^1.0.3",
    "eslint": "^10.12.0",
    "nanobench": "^3.0.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "size-limit": "^14.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.4"
  },
  "size-limit": [
    {
      "limit": "1 kB",
      "path": "dist/index.js"
    }
  ],
  "keywords": [
    "dni",
    "nie",
    "nif",
    "spain",
    "españa"
  ],
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "main",
      "next",
      "next-major",
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  }
}
